{
  "manifest_version": 3,
  "name": "GVCN Pro Copilot - Trợ Lý Lớp Học & Trình Chiếu",
  "version": "2.0.0",
  "description": "Trợ lý sư phạm trực tiếp trên Google Slides, Canva và mọi website: Bốc thăm học sinh, bấm giờ thảo luận nhóm, cộng sao thi đua, chuông hiệu lệnh.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GVCN Pro Classroom Copilot"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["classroom-dock.js"],
      "css": ["classroom-dock.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-chatgpt.js"],
      "css": ["content-chatgpt.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-classroom-dock": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Bật/Tắt thanh công cụ lớp học trên màn hình"
    }
  }
}
